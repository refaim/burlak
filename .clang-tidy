# Product code is checked for analyzer, bug-prone, performance and portability findings; every
# diagnostic is fatal. Vendored Far and doctest headers are deliberately outside the header filter.
---
# performance-no-int-to-ptr: Win32 and Far expose opaque handles as pointers while core stores non-owning handles as integers.
# bugprone-forward-declaration-namespace: the SDK's global Shell type is unrelated to our shell adapter namespace.
# bugprone-easily-swappable-parameters: foreign ABI callbacks and geometry values have contract-fixed adjacent fields.
# clang-analyzer-optin.core.EnumCastOutOfRange: MSVC's filesystem uses valid bitmask enum combinations that this checker rejects.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters,
  -performance-no-int-to-ptr,
  -bugprone-forward-declaration-namespace,
  -clang-analyzer-optin.core.EnumCastOutOfRange
WarningsAsErrors: '*'
HeaderFilterRegex: '.*[\\/](src|tests)[\\/].*'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  # Explicit static_cast<void> calls document intentionally ignored foreign-API results.
  bugprone-unused-return-value.AllowCastToVoid: true
  # Products of compile-time constants cannot overflow before conversion in this codebase.
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
...
