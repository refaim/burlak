#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    BURLAK_VERSION_MAJOR, BURLAK_VERSION_MINOR, BURLAK_VERSION_PATCH, 0
    PRODUCTVERSION BURLAK_VERSION_MAJOR, BURLAK_VERSION_MINOR, BURLAK_VERSION_PATCH, 0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_DLL
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Burlak - drag files out of Far Manager"
            VALUE "FileVersion",     BURLAK_VERSION_STRING
            VALUE "InternalName",    "Burlak"
            VALUE "OriginalFilename","Burlak.dll"
            VALUE "ProductName",     "Burlak"
            VALUE "ProductVersion",  BURLAK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
